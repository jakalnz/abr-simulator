{
  "name": "ABR Simulator",
  "short_name": "ABR Sim",
  "description": "Teaching simulator of auditory brainstem response (ABR) recording",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#ececec",
